<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة التحكم — الإعدادات</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="admin">
  <%- include('_nav') %>
  <div class="container">
    <h2>الإعدادات</h2>
    <% if (message) { %><div class="success"><%= message %></div><% } %>

    <form method="POST" action="/admin/settings" enctype="multipart/form-data" class="card settings-form">
      <label>شعار الفندق (PNG / JPG / WebP — حتى 2MB)
        <% if (hasLogo) { %>
          <img src="/logo" alt="الشعار الحالي" style="max-width:120px;border-radius:10px;margin:4px 0">
          <span class="muted">الشعار الحالي — اختر ملفاً جديداً لاستبداله</span>
        <% } %>
        <input type="file" name="logo" accept="image/png,image/jpeg,image/webp">
      </label>
      <% if (hasLogo) { %>
        <label class="inline-check"><input type="checkbox" name="remove_logo" value="1"> إزالة الشعار الحالي</label>
      <% } %>
      <label>اسم الفندق (عربي)
        <input type="text" name="hotel_name_ar" value="<%= values.hotel_name_ar %>" required>
      </label>
      <label>اسم الفندق (إنجليزي)
        <input type="text" name="hotel_name_en" value="<%= values.hotel_name_en %>" required>
      </label>
      <label>مدة قفل الغرفة بعد التعبئة (بالساعات)
        <input type="number" name="lock_hours" value="<%= values.lock_hours %>" min="1" max="720" required>
      </label>
      <label>رابط السيرفر (يُستخدم في رموز QR)
        <input type="text" name="base_url" value="<%= values.base_url %>" placeholder="https://survey.example.com" dir="ltr">
      </label>
      <label>كلمة مرور جديدة للوحة التحكم (اتركها فارغة لعدم التغيير)
        <input type="password" name="new_password" minlength="6" placeholder="6 أحرف على الأقل" dir="ltr">
      </label>
      <button type="submit" class="submit-btn">حفظ</button>
    </form>
  </div>
</body>
</html>
