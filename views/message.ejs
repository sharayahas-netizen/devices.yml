<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= hotel %> — <%= title %></title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="guest">
  <div class="container">
    <div class="card center-card">
      <h1 class="hotel-name"><%= hotel %></h1>
      <div class="big-icon"><%= title === t.thanksTitle ? '💚' : (title === t.closedTitle ? '✅' : '⚠️') %></div>
      <h2><%= title %></h2>
      <p><%= text %></p>
      <% if (token) { %>
        <p class="lang-switch"><a href="/s/<%= token %>?lang=<%= lang === 'ar' ? 'en' : 'ar' %>"><%= t.switchLang %></a></p>
      <% } %>
    </div>
  </div>
</body>
</html>
